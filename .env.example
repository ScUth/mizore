# Database Configuration
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=postgres
DB_NAME=mizore
DB_PORT=5432

# Fastify Backend
HOST=0.0.0.0
BACKEND_PORT=your_backend_port
# Host directory mounted into the backend as /files (e.g. D:/Music on Windows)
MUSIC_FOLDER=D:/Music
JWT_ACCESS_SECRET=your_JWT_access # can be anything
JWT_REFRESH_SECRET=your_JWT_refresh # can be anything

# Next.js Frontend
# Must be reachable from the browser; use the server's LAN IP for other devices.
NEXT_PUBLIC_API_URL=http://localhost:4000
