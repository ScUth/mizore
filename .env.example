# Database Configuration
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=postgres
DB_NAME=mizore
DB_PORT=5432

# Fastify Backend
HOST='localhost'
BACKEND_PORT=your_backend_port
SHARED_FOLDER=your_shared_folder
# Optional: several roots, comma-separated. Overrides SHARED_FOLDER when set.
# Each one must also be bind-mounted into the backend in docker-compose.yml.
# SHARED_FOLDERS=/home/yuki,/mnt/data
JWT_ACCESS_SECRET=your_JWT_access # can be anything
JWT_REFRESH_SECRET=your_JWT_refresh # can be anything

# Next.js Frontend
API_PROXY_TARGET=http://backend:4000
